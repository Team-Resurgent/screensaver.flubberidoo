<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="FlubberidooRunner"
	ProjectGUID="{E6B7A1C2-3F4D-4A9B-8C21-7D5E9A0B1C34}"
	Keyword="Xbox">
	<Platforms>
		<Platform
			Name="Xbox"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Xbox"
			OutputDirectory="Debug"
			IntermediateDirectory="Debug"
			ConfigurationType="1"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="./stubs;../src;../src/compat;&quot;$(XDK)\xbox\include&quot;"
				PreprocessorDefinitions="WIN32;_DEBUG;TARGET_WINDOWS;_XBOX;FLUBBERIDOO_NO_DX8_LIB_PRAGMA"
				MinimalRebuild="FALSE"
				BasicRuntimeChecks="0"
				RuntimeLibrary="1"
				BufferSecurityCheck="FALSE"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="dsoundd.lib xapilibd.lib d3d8d.lib d3dx8d.lib xgraphicsd.lib dmusicd.lib xactengd.lib xsndtrkd.lib xvoiced.lib xonlined.lib xboxkrnl.lib xbdm.lib xmvd.lib"
				OutputFile="$(OutDir)/FlubberidooRunner.exe"
				LinkIncremental="1"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="$(OutDir)/$(ProjectName).pdb"
				SubSystem="0"
				TargetMachine="0"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="XboxDeploymentTool"/>
			<Tool
				Name="XboxImageTool"/>
		</Configuration>
		<Configuration
			Name="Release|Xbox"
			OutputDirectory="Release"
			IntermediateDirectory="Release"
			ConfigurationType="1"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="2"
				FavorSizeOrSpeed="1"
				AdditionalIncludeDirectories="./stubs;../src;../src/compat;&quot;$(XDK)\xbox\include&quot;"
				PreprocessorDefinitions="WIN32;NDEBUG;TARGET_WINDOWS;_XBOX;FLUBBERIDOO_NO_DX8_LIB_PRAGMA"
				RuntimeLibrary="0"
				BufferSecurityCheck="FALSE"
				UsePrecompiledHeader="0"
				WarningLevel="1"
				DebugInformationFormat="0"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="dsound.lib xapilib.lib d3d8.lib d3dx8.lib xgraphics.lib dmusic.lib xacteng.lib xsndtrk.lib xvoice.lib xonline.lib xboxkrnl.lib xmv.lib"
				OutputFile="$(OutDir)/FlubberidooRunner.exe"
				LinkIncremental="1"
				GenerateDebugInformation="FALSE"
				SubSystem="0"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				TargetMachine="0"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="XboxDeploymentTool"/>
			<Tool
				Name="XboxImageTool"/>
		</Configuration>
	</Configurations>
